{
  "name": "freight-recovery-web",
  "private": true,
  "version": "0.1.0",
  "description": "Freight Recovery web app monorepo (API + web + shared). The Python service in src/ is separate.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.15.0 <23 || >=23.5.0 <25"
  },
  "scripts": {
    "prisma:generate": "prisma generate --config api/prisma.config.ts",
    "typecheck": "tsc -b packages/shared/tsconfig.build.json && tsc -p packages/shared/tsconfig.json && tsc -p api/tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w packages/shared && npm run test -w api && npm run test -w web",
    "test:integration": "npm run test:integration -w api",
    "test:acceptance": "npm run test:acceptance -w packages/shared && npm run test:acceptance -w api && npm run test:acceptance -w web",
    "db:migrate:deploy": "prisma migrate deploy --config api/prisma.config.ts",
    "db:seed": "npm run seed -w api --",
    "ensure-bucket": "npm run ensure-bucket -w api",
    "build": "npm run build -w packages/shared && npm run build -w api && npm run build -w web",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify:no-install-scripts": "node tools/verify-no-install-scripts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
