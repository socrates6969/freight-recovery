      "RecoveryResult": {
        "description": "Findings plus the total recoverable for the chosen perspective.",
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "ignored_findings": {
            "description": "Findings that belong to the other perspective; shown for transparency.",
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Ignored Findings",
            "type": "array"
          },
          "pending_review_total": {
            "default": "0.00",
            "description": "Sum of findings flagged needs_human_review; NOT claimed until a person confirms.",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Pending Review Total",
            "type": "string"
          },
          "perspective": {
            "$ref": "#/components/schemas/Perspective"
          },
          "recoverable_total": {
            "description": "Sum of CONFIRMED findings only (needs_human_review items are excluded).",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Recoverable Total",
            "type": "string"
          }
        },
        "required": [
          "perspective",
          "findings",
          "recoverable_total"
        ],
        "title": "RecoveryResult",
        "type": "object"
      },
      "TextAnalyzeRequest": {
        "description": "Inline-document analysis request.",
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/TextDocument"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          },
          "perspective": {
            "$ref": "#/components/schemas/Perspective",
            "default": "shipper"
          }
        },
        "required": [
          "documents"
        ],
        "title": "TextAnalyzeRequest",
        "type": "object"
      },
      "TextDocument": {
        "description": "A document supplied inline as text/CSV content.",
        "properties": {
          "content": {
            "maxLength": 1000000,
            "title": "Content",
            "type": "string"
          },
          "filename": {
            "examples": [
              "invoice.txt"
            ],
            "maxLength": 255,
            "title": "Filename",
            "type": "string"
          }
        },
        "required": [
          "filename",
          "content"
        ],
        "title": "TextDocument",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
