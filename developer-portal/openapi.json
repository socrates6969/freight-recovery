              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "title": "ExtractedBundle",
        "type": "object"
      },
      "Finding": {
        "description": "One rule hit with the arithmetic that produced it.",
        "properties": {
          "amount": {
            "description": "Positive dollars attributable to this finding.",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount",
            "type": "string"
          },
          "calculation": {
            "description": "Human-readable steps.",
            "items": {
              "type": "string"
            },
            "title": "Calculation",
            "type": "array"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "needs_human_review": {
            "default": false,
            "title": "Needs Human Review",
            "type": "boolean"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "title",
          "direction",
          "amount",
          "explanation",
          "confidence"
        ],
        "title": "Finding",
        "type": "object"
      },
