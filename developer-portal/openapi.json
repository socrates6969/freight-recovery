              "type": "object"
            },
            "title": "Documents",
            "type": "array"
          },
          "extracted": {
            "$ref": "#/components/schemas/ExtractedBundle"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "load_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
