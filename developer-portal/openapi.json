      "Perspective": {
        "description": "Whose money are we recovering?\n\nSHIPPER: recover overcharges the carrier billed us (credits/refunds).\nCARRIER: recover detention/accessorials earned but not billed (or under-billed).",
        "enum": [
          "shipper",
          "carrier"
        ],
        "title": "Perspective",
        "type": "string"
      },
      "RateConfirmation": {
