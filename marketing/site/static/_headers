# Security + cache headers for hosts that honour a Netlify/Cloudflare-style _headers file.
# On any other host, set the same headers in that host's config. The site loads no script and
# no third-party resource, so the CSP can stay this strict.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
/style.css
  Cache-Control: public, max-age=3600
/brand/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
