// Freight Recovery web API - PostgreSQL 16 schema.
// Tenant isolation is enforced in three layers: Postgres RLS (see migrations), a fail-closed
// Prisma client extension (api/src/db/tenant.ts), and per-request plumbing. Append-only tables
// are guarded by triggers and grants. Money is integer cents.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  REVIEWER
  ANALYST
  VIEWER
}

enum PlatformRole {
  PLATFORM_DEV
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum Perspective {
  SHIPPER
  CARRIER
}

enum ClaimStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SEND_READY
  AWAITING_ANALYSIS
}

enum PacketStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SEND_READY
  SUPERSEDED
}

enum ApprovalAction {
  EDIT
  APPROVE
  REJECT
  SEND_READY
}

enum DocType {
  INVOICE
  RATE_CONFIRMATION
  BILL_OF_LADING
  OTHER
}

enum TimelineKind {
  APPOINTMENT
  ARRIVAL
  DEPARTURE
  INVOICE
  RATE_CONFIRMATION
  NOTE
}

enum Direction {
  OVERCHARGE
  UNDERBILLED
}

enum VerifierStatus {
  NOT_RUN
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum ImportSource {
  UPLOAD
  EMAIL
}

enum DetectedType {
  PDF
  PNG
  JPEG
  CSV
  TXT
}

enum ImportDocStatus {
  RECEIVED
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
  FAILED
}

enum DocTypeBasis {
  HEADER
  KEYS
  FILENAME
  MANUAL
  NONE
}

enum FieldKind {
  STRING
  DECIMAL
  DATETIME
  STRING_LIST
}

enum FieldStatus {
  PROPOSED
  CONFIRMED
  CORRECTED
  REJECTED
}

enum FieldOrigin {
  EXTRACTED
  MANUAL
}

enum ReviewAction {
  CONFIRM
  CORRECT
  REJECT
  ADD
  SET_TYPE
  ACCEPT
  REJECT_DOC
}

enum MailKind {
  PASSWORD_RESET
  INVITE
}

enum LoginOutcome {
  SUCCESS
  BAD_PASSWORD
  BAD_MFA
  LOCKED
  UNKNOWN_USER
  DISABLED
}

// ---------------------------------------------------------------------------------------------
// Global tables (no RLS). Reachable only through api/src/db/system.ts (auth/platform/audit).
// ---------------------------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships     Membership[]
  invites         Invite[]
  claims          Claim[]
  packets         EvidencePacket[]
  packetSources   PacketSource[]
  packetTimeline  PacketTimelineEvent[]
  packetFindings  PacketFinding[]
  approvals       Approval[]
  importBatches   ImportBatch[]
  importDocuments ImportDocument[]
  extractedFields ExtractedField[]
  reviewDecisions ImportReviewDecision[]
  claimDocuments  ClaimDocument[]
  apiKeys         ApiKey[]

  @@map("tenants")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  name              String
  passwordHash      String        @map("password_hash")
  status            UserStatus    @default(ACTIVE)
  platformRole      PlatformRole? @map("platform_role")
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership     Membership?
  refreshTokens  RefreshToken[]
  mfaSecret      MfaSecret?
  recoveryCodes  MfaRecoveryCode[]
  passwordResets PasswordReset[]
  invitesSent    Invite[]               @relation("InvitedBy")
  assignedClaims Claim[]                @relation("ClaimAssignee")
  packetsCreated EvidencePacket[]       @relation("PacketCreatedBy")
  approvals      Approval[]             @relation("ApprovalActor")
  importBatches  ImportBatch[]          @relation("ImportBatchCreatedBy")
  importUploads  ImportDocument[]       @relation("ImportDocumentUploadedBy")
  fieldsResolved ExtractedField[]       @relation("ExtractedFieldResolvedBy")
  reviewActions  ImportReviewDecision[] @relation("ReviewDecisionActor")
  documentLinks  ClaimDocument[]        @relation("ClaimDocumentLinkedBy")
  flagChanges    FeatureFlag[]          @relation("FeatureFlagUpdatedBy")
  apiKeysCreated ApiKey[]               @relation("ApiKeyCreatedBy")
  apiKeysRevoked ApiKey[]               @relation("ApiKeyRevokedBy")

  @@map("users")
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  parentId        String?   @map("parent_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason   String?   @map("revoked_reason")
  ip              String?
  userAgentHash   String?   @map("user_agent_hash")

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model MfaSecret {
  userId       String    @id @map("user_id") @db.Uuid
  ciphertext   Bytes
  nonce        Bytes
  keyId        String    @map("key_id")
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(3)
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("mfa_secrets")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model LoginAttempt {
  id        String       @id @default(uuid()) @db.Uuid
  emailHash String       @map("email_hash")
  ip        String?
  outcome   LoginOutcome
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([emailHash, createdAt])
  @@map("login_attempts")
}

model LoginLockout {
  emailHash     String    @id @map("email_hash")
  failures      Int       @default(0)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(3)

  @@map("login_lockouts")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

model MailOutbox {
  id        String   @id @default(uuid()) @db.Uuid
  toEmail   String   @map("to_email")
  kind      MailKind
  token     String
  tenantId  String?  @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([toEmail, createdAt])
  @@map("mail_outbox")
}

// ---------------------------------------------------------------------------------------------
// Tenant-scoped tables (tenant_id NOT NULL + RLS FORCE). Composite FKs keep children in the
// same tenant as their parents even though FK checks bypass RLS.
// ---------------------------------------------------------------------------------------------

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId])
  @@map("invites")
}

model Claim {
  id                 String      @id @default(uuid()) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  claimNumber        String      @map("claim_number")
  loadNumber         String?     @map("load_number")
  invoiceNumber      String?     @map("invoice_number")
  invoiceDate        DateTime?   @map("invoice_date") @db.Timestamptz(3)
  carrierName        String      @map("carrier_name")
  shipperName        String      @map("shipper_name")
  perspective        Perspective
  status             ClaimStatus @default(PENDING_REVIEW)
  amountClaimedCents Int         @map("amount_claimed_cents")
  recoverableCents   Int         @map("recoverable_cents")
  pendingReviewCents Int         @map("pending_review_cents")
  currency           String      @default("USD")
  assigneeId         String?     @map("assignee_id") @db.Uuid
  version            Int         @default(0)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  assignee  User?            @relation("ClaimAssignee", fields: [assigneeId], references: [id])
  packets   EvidencePacket[]
  approvals Approval[]
  documents ClaimDocument[]

  @@unique([tenantId, claimNumber])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, updatedAt(sort: Desc), id])
  @@map("claims")
}

model EvidencePacket {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  claimId            String         @map("claim_id") @db.Uuid
  revision           Int
  status             PacketStatus   @default(PENDING_REVIEW)
  perspective        Perspective
  loadNumber         String?        @map("load_number")
  generatedAt        DateTime       @map("generated_at") @db.Timestamptz(3)
  disclaimer         String
  demandLetter       String         @map("demand_letter")
  currency           String         @default("USD")
  recoverableCents   Int            @map("recoverable_cents")
  pendingReviewCents Int            @map("pending_review_cents")
  verifierStatus     VerifierStatus @default(NOT_RUN) @map("verifier_status")
  verifierCheckedAt  DateTime?      @map("verifier_checked_at") @db.Timestamptz(3)
  verifierNote       String?        @map("verifier_note")
  contentHash        String         @map("content_hash")
  createdById        String?        @map("created_by_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  claim     Claim                 @relation(fields: [claimId, tenantId], references: [id, tenantId])
  createdBy User?                 @relation("PacketCreatedBy", fields: [createdById], references: [id])
  sources   PacketSource[]
  timeline  PacketTimelineEvent[]
  findings  PacketFinding[]
  approvals Approval[]

  @@unique([claimId, revision])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("evidence_packets")
}

model PacketSource {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  packetId  String  @map("packet_id") @db.Uuid
  filename  String
  docType   DocType @map("doc_type")
  sha256    String
  sizeBytes Int     @map("size_bytes")
  ordinal   Int

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  packet EvidencePacket @relation(fields: [packetId, tenantId], references: [id, tenantId])

  @@unique([packetId, ordinal])
  @@map("packet_sources")
}

model PacketTimelineEvent {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  packetId   String       @map("packet_id") @db.Uuid
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(3)
  kind       TimelineKind
  label      String
  sourceId   String?      @map("source_id") @db.Uuid
  ordinal    Int

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  packet EvidencePacket @relation(fields: [packetId, tenantId], references: [id, tenantId])

  @@unique([packetId, ordinal])
  @@map("packet_timeline_events")
}

model PacketFinding {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  packetId         String    @map("packet_id") @db.Uuid
  ordinal          Int
  ruleId           String    @map("rule_id")
  title            String
  direction        Direction
  amountCents      Int       @map("amount_cents")
  explanation      String
  calculation      Json
  confidence       Decimal   @db.Decimal(4, 3)
  needsHumanReview Boolean   @map("needs_human_review")
  citations        Json
  clauseSourceId   String?   @map("clause_source_id") @db.Uuid
  clauseLabel      String?   @map("clause_label")
  clauseExcerpt    String?   @map("clause_excerpt")
  clauseLocator    String?   @map("clause_locator")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  packet EvidencePacket @relation(fields: [packetId, tenantId], references: [id, tenantId])

  @@unique([packetId, ordinal])
  @@map("packet_findings")
}

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  claimId        String         @map("claim_id") @db.Uuid
  packetId       String         @map("packet_id") @db.Uuid
  packetRevision Int            @map("packet_revision")
  action         ApprovalAction
  reason         String
  fromStatus     String         @map("from_status")
  toStatus       String         @map("to_status")
  contentHash    String         @map("content_hash")
  actorId        String         @map("actor_id") @db.Uuid
  actorRole      String         @map("actor_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  claim  Claim          @relation(fields: [claimId, tenantId], references: [id, tenantId])
  packet EvidencePacket @relation(fields: [packetId, tenantId], references: [id, tenantId])
  actor  User           @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([tenantId, claimId, createdAt])
  @@map("approvals")
}

// ---------------------------------------------------------------------------------------------
// Step 3: imports (upload pipeline, extracted fields with provenance, human review) and the
// document -> claim links. All tenant-scoped with RLS FORCE; see migration 20261009000000.
// ---------------------------------------------------------------------------------------------

model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  label       String?
  source      ImportSource @default(UPLOAD)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  createdBy User             @relation("ImportBatchCreatedBy", fields: [createdById], references: [id])
  documents ImportDocument[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@map("import_batches")
}

model ImportDocument {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  batchId         String          @map("batch_id") @db.Uuid
  uploadedById    String?         @map("uploaded_by_id") @db.Uuid
  source          ImportSource
  sourceRef       String?         @map("source_ref")
  displayName     String          @map("display_name")
  detectedType    DetectedType    @map("detected_type")
  sizeBytes       Int             @map("size_bytes")
  sha256          String          @db.Char(64)
  storageKey      String?         @map("storage_key")
  textKey         String?         @map("text_key")
  docType         DocType         @map("doc_type")
  docTypeBasis    DocTypeBasis    @map("doc_type_basis")
  status          ImportDocStatus
  rejectReason    String?         @map("reject_reason")
  reviewReasons   String[]        @map("review_reasons")
  warnings        String[]
  pageCount       Int?            @map("page_count")
  charCount       Int?            @map("char_count")
  loadNumber      String?         @map("load_number")
  providerName    String          @map("provider_name")
  providerVersion String          @map("provider_version")
  parserVersion   String          @map("parser_version")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  parsedAt        DateTime?       @map("parsed_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  batch      ImportBatch            @relation(fields: [batchId, tenantId], references: [id, tenantId])
  uploadedBy User?                  @relation("ImportDocumentUploadedBy", fields: [uploadedById], references: [id])
  fields     ExtractedField[]
  decisions  ImportReviewDecision[]
  claimLinks ClaimDocument[]

  @@unique([tenantId, batchId, sha256])
  @@unique([id, tenantId])
  @@index([tenantId, batchId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, sha256])
  @@map("import_documents")
}

model ExtractedField {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  documentId     String      @map("document_id") @db.Uuid
  key            String
  groupIndex     Int?        @map("group_index")
  ordinal        Int
  kind           FieldKind
  value          String?
  rawValue       String      @map("raw_value")
  correctedValue String?     @map("corrected_value")
  confidence     Decimal     @db.Decimal(4, 3)
  needsReview    Boolean     @map("needs_review")
  reviewReasons  String[]    @map("review_reasons")
  status         FieldStatus @default(PROPOSED)
  origin         FieldOrigin
  page           Int?
  line           Int?
  startCol       Int?        @map("start_col")
  endCol         Int?        @map("end_col")
  sourceRow      Int?        @map("source_row")
  excerpt        String?
  resolvedById   String?     @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  document   ImportDocument         @relation(fields: [documentId, tenantId], references: [id, tenantId])
  resolvedBy User?                  @relation("ExtractedFieldResolvedBy", fields: [resolvedById], references: [id])
  decisions  ImportReviewDecision[]

  @@unique([id, tenantId])
  @@index([tenantId, documentId])
  @@map("extracted_fields")
}

model ImportReviewDecision {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  documentId        String       @map("document_id") @db.Uuid
  fieldId           String?      @map("field_id") @db.Uuid
  action            ReviewAction
  reason            String
  beforeValueSha256 String?      @map("before_value_sha256")
  afterValueSha256  String?      @map("after_value_sha256")
  actorId           String       @map("actor_id") @db.Uuid
  actorRole         String       @map("actor_role")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  document ImportDocument  @relation(fields: [documentId, tenantId], references: [id, tenantId])
  field    ExtractedField? @relation(fields: [fieldId, tenantId], references: [id, tenantId])
  actor    User            @relation("ReviewDecisionActor", fields: [actorId], references: [id])

  @@index([tenantId, documentId, createdAt])
  @@map("import_review_decisions")
}

model ClaimDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  linkedById String   @map("linked_by_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  claim    Claim          @relation(fields: [claimId, tenantId], references: [id, tenantId])
  document ImportDocument @relation(fields: [documentId, tenantId], references: [id, tenantId])
  linkedBy User           @relation("ClaimDocumentLinkedBy", fields: [linkedById], references: [id])

  @@unique([tenantId, documentId])
  @@index([tenantId, claimId])
  @@map("claim_documents")
}

model AuditEvent {
  id         String   @id @db.Uuid
  chainKey   String   @map("chain_key")
  tenantId   String?  @map("tenant_id") @db.Uuid
  seq        BigInt
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json
  ip         String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  prevHash   String   @map("prev_hash")
  hash       String

  @@unique([chainKey, seq])
  @@index([tenantId, seq])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------------------------
// Step 4: platform tables (NOT tenant-scoped; RLS FORCE with system-mode policies, see migration
// 20261010000000) and tenant API keys (tenant-scoped, RLS FORCE).
// ---------------------------------------------------------------------------------------------

model FeatureFlag {
  key         String    @id
  enabled     Boolean
  version     Int       @default(1)
  updatedById String?   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(3)
  lastReason  String?   @map("last_reason")

  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id])

  @@map("feature_flags")
}

model EvalRun {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evalSetId            String   @map("eval_set_id")
  evalSetVersion       String   @map("eval_set_version")
  evalSetSha256        String   @map("eval_set_sha256") @db.Char(64)
  stage                String
  k                    Int
  startedAt            DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime @map("finished_at") @db.Timestamptz(3)
  gitSha               String?  @map("git_sha")
  providerName         String   @map("provider_name")
  providerVersion      String   @map("provider_version")
  parserVersion        String   @map("parser_version")
  caseCount            Int      @map("case_count")
  runsTotal            Int      @map("runs_total")
  runsPassed           Int      @map("runs_passed")
  passHatKCount        Int      @map("pass_hat_k_count")
  passAtLeastOneCount  Int      @map("pass_at_least_one_count")
  flakyCaseCount       Int      @map("flaky_case_count")
  alwaysFailCount      Int      @map("always_fail_count")
  deterministicCases   Int      @map("deterministic_cases")
  wilsonLow            Decimal  @map("wilson_low") @db.Decimal(8, 6)
  wilsonHigh           Decimal  @map("wilson_high") @db.Decimal(8, 6)
  passPowCurve         Float[]  @map("pass_pow_curve")
  runMsP50             Float    @map("run_ms_p50")
  runMsP95             Float    @map("run_ms_p95")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  results EvalCaseResult[]

  @@index([createdAt])
  @@map("eval_runs")
}

model EvalCaseResult {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId            String  @map("run_id") @db.Uuid
  caseId           String  @map("case_id")
  category         String
  runsPassed       Int     @map("runs_passed")
  k                Int
  passedAll        Boolean @map("passed_all")
  distinctOutputs  Int     @map("distinct_outputs")
  firstFailureCode String? @map("first_failure_code")
  medianDurationMs Float   @map("median_duration_ms")

  run EvalRun @relation(fields: [runId], references: [id])

  @@unique([runId, caseId])
  @@map("eval_case_results")
}

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  keyId        String    @unique @map("key_id") @db.Char(16)
  name         String
  secretHash   String    @map("secret_hash") @db.Char(64)
  scopes       String[]
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  revokedBy User?  @relation("ApiKeyRevokedBy", fields: [revokedById], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("api_keys")
}
