# Freight Recovery web stack - example environment. PLACEHOLDERS ONLY: never put real secrets here.
# Copy to .env (git-ignored) for local development. Production values come from AWS Secrets Manager.

# --- API (required) ---
DATABASE_URL=postgresql://freight_app:local-dev-only@127.0.0.1:5433/freight_web
# Secrets: random hex (openssl rand -hex 32) or base64 (openssl rand -base64 48) are both valid.
JWT_SECRET=<at-least-43-chars-random; e.g. openssl rand -hex 32 or openssl rand -base64 48>
CSRF_SECRET=<at-least-43-chars-random>
REFRESH_PEPPER=<at-least-43-chars-random>
MFA_ENC_KEY=<base64 of 32 random bytes; openssl rand -base64 32>
APP_ORIGIN=http://127.0.0.1:5173

# --- API (optional) ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
COOKIE_SECURE=false            # dev over http only; refused in production
ENABLE_DEV_OUTBOX=true         # dev only: GET /api/v1/dev/outbox shows reset/invite tokens; refused in production
MAIL_TRANSPORT=outbox          # dev/test sink; production refuses every MAIL_TRANSPORT until a real transport exists
# REDIS_URL=redis://127.0.0.1:6379   # required in production (rate-limit store)
# TRUST_PROXY=10.0.0.0/8

# --- Object storage (MinIO in dev/CI, S3 in AWS); create the bucket with: npm run ensure-bucket ---
# Values match compose.web.yml (public dev values). Every object is written with SSE: production
# requires S3_SSE=aws:kms and S3_KMS_KEY_ID = the data CMK ARN. For MinIO, S3_KMS_KEY_ID is the key
# name of MINIO_KMS_SECRET_KEY (fr-dev-key:<base64 of 32 random bytes>); S3_SSE=none is the documented
# dev-only fallback when a MinIO build cannot do KMS.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fr-documents-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev-minio-password
S3_SSE=aws:kms
S3_KMS_KEY_ID=fr-dev-key

# --- Import / export limits (step 3; defaults shown, production floors/ceilings in api/src/config.ts) ---
# IMPORT_MAX_FILE_BYTES=10485760  IMPORT_MAX_FILES_PER_BATCH=10  TENANT_STORAGE_QUOTA_BYTES=1073741824
# UPLOAD_REQUEST_TIMEOUT_SECONDS=60  UPLOAD_IDLE_TIMEOUT_SECONDS=10  UPLOAD_MAX_CONCURRENT_PER_TENANT=4
# PARSE_TIMEOUT_MS=20000  PARSE_MEMORY_MB=256  PARSE_MAX_CONCURRENCY=2  PARSE_QUEUE_TIMEOUT_MS=5000
# PARSE_MAX_OUTPUT_BYTES=25165824  PARSE_MAX_PDF_PAGES=50  PARSE_MAX_TEXT_CHARS=2000000
# PARSE_MAX_IMAGE_PIXELS=50000000  REVIEW_CONFIDENCE_THRESHOLD=0.90  IMPORT_STALE_SECONDS=600
# EXPORT_MAX_ROWS=50000  EXPORT_MAX_CONCURRENT_PER_TENANT=2  RATE_LIMIT_UPLOAD_MAX=60  RATE_LIMIT_EXPORT_MAX=10
# PARSE_WORKER_ENTRY=<defaults to the built api/dist/src/imports/sandbox/worker-main.js>

# --- Migrations / seed (owner role; bypasses RLS) ---
MIGRATE_DATABASE_URL=postgresql://freight_owner:local-dev-only@127.0.0.1:5433/freight_web
# Seed: NODE_ENV=development npm run db:seed            (idempotent)
#       NODE_ENV=development npm run db:seed -- --reset (wipe + recreate seed tenants)
# The seed only runs against a loopback/compose host (127.0.0.1, localhost, ::1, postgres) unless ALLOW_SEED=1.

# --- Tests ---
TEST_DATABASE_URL=postgresql://freight_app:local-dev-only@127.0.0.1:5433/freight_web_test
TEST_ADMIN_DATABASE_URL=postgresql://freight_owner:local-dev-only@127.0.0.1:5433/freight_web_test
