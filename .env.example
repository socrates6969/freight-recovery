# Freight Recovery web stack - example environment. PLACEHOLDERS ONLY: never put real secrets here.
# Copy to .env (git-ignored) for local development. Production values come from AWS Secrets Manager.

# --- API (required) ---
DATABASE_URL=postgresql://freight_app:local-dev-only@127.0.0.1:5433/freight_web
JWT_SECRET=<at-least-43-chars-random; e.g. openssl rand -base64 48>
CSRF_SECRET=<at-least-43-chars-random>
REFRESH_PEPPER=<at-least-43-chars-random>
MFA_ENC_KEY=<base64 of 32 random bytes; openssl rand -base64 32>
APP_ORIGIN=http://127.0.0.1:5173

# --- API (optional) ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
COOKIE_SECURE=false            # dev over http only; refused in production
ENABLE_DEV_OUTBOX=true         # dev only: GET /dev/outbox shows reset/invite tokens; refused in production
MAIL_TRANSPORT=outbox
# REDIS_URL=redis://127.0.0.1:6379   # required in production (rate-limit store)
# TRUST_PROXY=10.0.0.0/8

# --- Migrations / seed (owner role; bypasses RLS) ---
MIGRATE_DATABASE_URL=postgresql://freight_owner:local-dev-only@127.0.0.1:5433/freight_web
# Seed: NODE_ENV=development npm run db:seed            (idempotent)
#       NODE_ENV=development npm run db:seed -- --reset (wipe + recreate seed tenants)

# --- Tests ---
TEST_DATABASE_URL=postgresql://freight_app:local-dev-only@127.0.0.1:5433/freight_web_test
TEST_ADMIN_DATABASE_URL=postgresql://freight_owner:local-dev-only@127.0.0.1:5433/freight_web_test
