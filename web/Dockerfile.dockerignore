# BuildKit uses this file (instead of the root .dockerignore) for web/Dockerfile. Allow-list style.
*
!package.json
!package-lock.json
!.npmrc
!tsconfig.base.json
!packages/shared/package.json
!packages/shared/tsconfig.build.json
!packages/shared/tsconfig.json
!packages/shared/src/**
!api/package.json
!web/package.json
!web/tsconfig.json
!web/vite.config.ts
!web/index.html
!web/security-headers.json
!web/nginx.conf
!web/src/**
!web/tools/**
**/*.test.ts
**/*.test.tsx
**/node_modules
**/dist
