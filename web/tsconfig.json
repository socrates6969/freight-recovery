{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "customConditions": ["source"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "test-acceptance/**/*.ts", "test-acceptance/**/*.tsx", "product/**/*.ts", "product/**/*.tsx", "vite.config.ts", "vite.product.config.ts", "vitest.config.ts"]
}
